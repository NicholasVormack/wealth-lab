# Wealth Lab Environment Variables
# Copy this file to .env and fill in your keys as you acquire them.
# The engine auto-detects keys and flips endpoints to READY.

# Vercel (optional, for automated deployments)
VERCEL_TOKEN=

# Medium (optional, for automated publishing)
MEDIUM_ACCESS_TOKEN=

# Dev.to (optional, for automated publishing)
DEVTO_API_KEY=

# Gumroad (optional, for digital product storefront)
GUMROAD_ACCESS_TOKEN=

# Ko-fi (optional, for donations/digital products)
KOFI_API_KEY=

# Amazon Associates (optional, affiliate tag)
AMAZON_ASSOCIATE_TAG=

# X / Twitter (optional, for automated social distribution)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Reddit (optional, for automated social distribution)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# YouTube (optional, for video API)
YOUTUBE_API_KEY=
